# Next.js Application Environment Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Supabase / Database Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Internal Server-to-Server Secret (must match INTERNAL_API_SECRET in backend/.env)
INTERNAL_API_SECRET=your_internal_api_secret_here

# Google OAuth Credentials (configured in Google Cloud Console)
# Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#                       or http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional Local AI (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5
