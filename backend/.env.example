# FastAPI
APP_ENV=development
API_V1_PREFIX=/api/v1
# Local persistence (SQLite demo database; ignored by Git)

DATABASE_PATH=backend/data/skillbridge.db
MODEL_CACHE_DIR=backend/models

# Pretrained NLP / embedding models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
ENABLE_EMBEDDINGS=true
ENABLE_SPACY=true

# Optional BGE reranker (disabled by default because BGE-M3 is ~2.2 GB)
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Local Qwen through Ollama. Qwen2.5-Coder 3B is already installed on this machine.
ENABLE_LLM=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=75
OLLAMA_NUM_PREDICT=420

ENABLE_WHISPER=false
WHISPER_MODEL=small

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
