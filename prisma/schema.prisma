generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ResumeStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum SkillSource {
  SELF_REPORTED
  RESUME
  INTERVIEW
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum LearningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  // Supabase Auth owns the identity; this row is the application profile.
  id               String            @id @db.Uuid
  email            String?           @unique
  displayName      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  resumes          Resume[]
  careerProfile    CareerProfile?
  skills           UserSkill[]
  interviewSessions InterviewSession[]
  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
  applications Application[]
  savedJobs SavedJob[]
  skillGaps SkillGap[]
  roadmaps LearningRoadmap[]
}

model Resume {
  id           String       @id @default(cuid())
  userId       String       @db.Uuid
  originalName String
  mimeType     String
  storageKey   String
  status       ResumeStatus @default(UPLOADED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CareerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique @db.Uuid
  targetRole      String?
  targetCompany   String?
  readinessScore  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String      @id @default(cuid())
  name      String      @unique
  userSkills UserSkill[]
  jobRequirements JobRequirement[]
  skillGaps SkillGap[]
  learningItems RoadmapItem[]
}

model UserSkill {
  id          String     @id @default(cuid())
  userId      String     @db.Uuid
  skillId     String
  source      SkillSource
  confidence  Int?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, source])
  @@index([userId])
}

model InterviewSession {
  id          String          @id @default(cuid())
  userId      String          @db.Uuid
  targetRole  String
  status      InterviewStatus @default(IN_PROGRESS)
  score       Int?
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions   InterviewQuestion[]
  answers     InterviewAnswer[]
  report      InterviewReport?

  @@index([userId, startedAt])
}

model CandidateProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @db.Uuid
  headline       String?
  location       String?
  portfolioUrl   String?
  yearsExperience Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecruiterProfile {
  id          String   @id @default(cuid())
  userId      String   @unique @db.Uuid
  company     String?
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs        Job[]
}

model Job {
  id              String           @id @default(cuid())
  recruiterId     String
  title           String
  description     String
  location        String?
  employmentType  String?
  status          JobStatus         @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  recruiter       RecruiterProfile  @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  requirements    JobRequirement[]
  applications    Application[]
  savedBy         SavedJob[]

  @@index([status, createdAt])
}

model JobRequirement {
  id       String  @id @default(cuid())
  jobId    String
  skillId  String
  required Boolean @default(true)
  priority Int     @default(1)
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill    Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model SkillGap {
  id             String   @id @default(cuid())
  userId         String   @db.Uuid
  skillId        String
  targetRole     String
  priority       Int      @default(1)
  estimatedHours Int?
  assessedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill          Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([userId, targetRole])
}

model LearningRoadmap {
  id          String        @id @default(cuid())
  userId      String        @db.Uuid
  targetRole  String
  title       String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       RoadmapItem[]

  @@index([userId, updatedAt])
}

model RoadmapItem {
  id            String        @id @default(cuid())
  roadmapId     String
  skillId       String?
  title         String
  objective     String
  resourceUrl   String?
  difficulty    String?
  estimatedHours Int?
  practiceTask  String?
  status        LearningStatus @default(NOT_STARTED)
  roadmap       LearningRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  skill         Skill?         @relation(fields: [skillId], references: [id], onDelete: SetNull)
  progress      LearningProgress[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  provider    String
  url         String?
  priceType   String
  difficulty  String?
  durationHours Float?
  skillId     String?
  progress    LearningProgress[]
}

model LearningProgress {
  id           String        @id @default(cuid())
  userId       String        @db.Uuid
  courseId     String?
  roadmapItemId String?
  status       LearningStatus @default(NOT_STARTED)
  progressPct  Int           @default(0)
  updatedAt    DateTime      @updatedAt
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  roadmapItem  RoadmapItem?  @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model InterviewQuestion {
  id        String            @id @default(cuid())
  sessionId String
  prompt    String
  sequence  Int
  topic     String?
  session   InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers   InterviewAnswer[]

  @@unique([sessionId, sequence])
}

model InterviewAnswer {
  id         String            @id @default(cuid())
  sessionId  String
  questionId String
  answerText String
  evaluation Json?
  createdAt  DateTime          @default(now())
  session    InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model InterviewReport {
  id            String           @id @default(cuid())
  sessionId     String           @unique
  overallScore  Int
  strengths     Json
  improvements  Json
  topicScores   Json
  createdAt     DateTime         @default(now())
  session       InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Application {
  id          String            @id @default(cuid())
  userId      String            @db.Uuid
  jobId       String
  status      ApplicationStatus @default(APPLIED)
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId, status])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  jobId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}
